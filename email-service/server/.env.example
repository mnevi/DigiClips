# Ollama Configuration
# Canonical Ollama setting. OLLAMA_API_URL is accepted as a legacy alias,
# but new setups should use OLLAMA_URL.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digiclips_db"

# Web Search (Optional)
# Get free API key at https://serper.dev
# Free tier: 100 searches/month
SERPER_API_KEY=your_serper_api_key_here

# SMTP (Required for /api/send-email)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="DigiClips <no-reply@example.com>"

# Temporary demo-user fallback until real auth is implemented
DEFAULT_USER_EMAIL=demo@digiclips.local
DEFAULT_USER_NAME=Demo User

# Server Configuration (Optional)
PORT=3000
